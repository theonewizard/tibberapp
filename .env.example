# Copy to .env and fill in. Placeholders only; never commit the real file.

# Fernet key that encrypts upstream tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=replace-with-a-fernet-key

# Data API OAuth client from https://data-api.tibber.com/clients/manage
OAUTH_CLIENT_ID=replace-with-client-id
OAUTH_CLIENT_SECRET=replace-with-client-secret
# Must match the redirect URI registered for the client exactly (scheme, host, path, trailing slash).
OAUTH_REDIRECT_URI=https://energy.example.com/oauth/callback

# Single-user sign-in. Generate with: python -m app.hash_password  (keep the single quotes)
APP_PASSWORD_HASH='replace-with-argon2-hash'

# Default time zone for homes the GraphQL API does not describe.
TZ=Europe/Stockholm
DB_PATH=./data/home-energy.sqlite3
# host:port the app listens on (inside the container use 0.0.0.0:8080).
BIND=127.0.0.1:8080
USER_AGENT=home-energy/0.1

# Optional
# PUBLIC_ORIGIN=https://energy.example.com      # defaults to the origin of OAUTH_REDIRECT_URI
# RATE_LIMIT_PER_MINUTE=120
# FORWARDED_ALLOW_IPS=127.0.0.1                  # proxies allowed to set X-Forwarded-*
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=home-energy
